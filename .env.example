# Spring datasource
DB_URL=jdbc:mysql://localhost:3306/ecommer_fco?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_db_username_here
DB_PASSWORD=your_db_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_TIMEOUT=2s

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_mail_username_here
MAIL_PASSWORD=your_mail_password_here

# JWT
JWT_SECRET_KEY=your_jwt_secret_here
JWT_ACCESS_EXPIRED_MS=900000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Seed path
SEED_PLAYERS_FILE_PATH=/app/data/players.json

# Google Gemini AI (Community Insight — Moderation & Summarization)
GEMINI_API_KEY=your_gemini_api_key_here
